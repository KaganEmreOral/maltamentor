# Site (required for sitemap/OG)
NEXT_PUBLIC_SITE_URL=https://maltamentor.com

# Contact form – receiver (where form submissions are sent)
CONTACT_RECEIVER_EMAIL=info@maltamentor.com

# SMTP – Nodemailer (for sending contact form emails)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password

# Optional: custom "From" (defaults to EMAIL_USER)
# EMAIL_FROM=Mentor Malta <noreply@maltamentor.com>

# Optional: where to store contact messages (default: ./data)
# CONTACT_LOG_DIR=/var/www/maltamentor/data

# Sanity CMS (optional – leave empty to hide blog or use static data)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
