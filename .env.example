# Site (required for sitemap/OG)
NEXT_PUBLIC_SITE_URL=https://mentormalta.com

# Sanity CMS (optional – leave empty to hide blog or use static data)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Contact form & Newsletter (Resend)
RESEND_API_KEY=
CONTACT_EMAIL=info@mentormalta.com
EMAIL_FROM=Mentor Malta <noreply@mentormalta.com>

# Newsletter audience (optional – for Resend audience/contact list)
RESEND_AUDIENCE_ID=

# Calendly embed
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/meeting
